{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://krillelen.github.io/maklarspaning-goteborg/data/financial-import.schema.json",
  "title": "Mäklarspaning – finansiell import",
  "type": "object",
  "required": ["source", "retrievedAt", "companies"],
  "properties": {
    "source": {
      "type": "string",
      "minLength": 2
    },
    "retrievedAt": {
      "type": "string",
      "format": "date"
    },
    "companies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["orgNo", "periods"],
        "properties": {
          "orgNo": {
            "type": "string",
            "pattern": "^[0-9]{6}-?[0-9]{4}$"
          },
          "periods": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/period"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "period": {
      "type": "object",
      "required": ["fiscalYear", "source", "sourceUrl"],
      "properties": {
        "year": {"type": "integer", "minimum": 1900, "maximum": 2200},
        "fiscalYear": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}$"},
        "startDate": {"type": "string", "format": "date"},
        "endDate": {"type": "string", "format": "date"},
        "currency": {"type": "string"},
        "source": {"type": "string"},
        "sourceUrl": {"type": "string", "format": "uri"},
        "sourceDocumentId": {"type": ["string", "null"]},
        "registeredAt": {"type": ["string", "null"], "format": "date"},
        "retrievedAt": {"type": "string", "format": "date"},
        "isPrimaryPeriod": {"type": "boolean"},
        "netRevenueKsek": {"type": ["number", "null"]},
        "otherRevenueKsek": {"type": ["number", "null"]},
        "revenueKsek": {"type": ["number", "null"]},
        "operatingCostsKsek": {"type": ["number", "null"]},
        "ebitdaKsek": {"type": ["number", "null"]},
        "depreciationKsek": {"type": ["number", "null"]},
        "operatingProfitKsek": {"type": ["number", "null"]},
        "financialIncomeKsek": {"type": ["number", "null"]},
        "financialCostsKsek": {"type": ["number", "null"]},
        "profitAfterFinancialKsek": {"type": ["number", "null"]},
        "profitBeforeTaxKsek": {"type": ["number", "null"]},
        "taxKsek": {"type": ["number", "null"]},
        "netIncomeKsek": {"type": ["number", "null"]},
        "proposedDividendKsek": {"type": ["number", "null"]},
        "intangibleAssetsKsek": {"type": ["number", "null"]},
        "tangibleAssetsKsek": {"type": ["number", "null"]},
        "financialAssetsKsek": {"type": ["number", "null"]},
        "fixedAssetsKsek": {"type": ["number", "null"]},
        "inventoryKsek": {"type": ["number", "null"]},
        "receivablesKsek": {"type": ["number", "null"]},
        "cashKsek": {"type": ["number", "null"]},
        "currentAssetsKsek": {"type": ["number", "null"]},
        "totalAssetsKsek": {"type": ["number", "null"]},
        "equityKsek": {"type": ["number", "null"]},
        "untaxedReservesKsek": {"type": ["number", "null"]},
        "provisionsKsek": {"type": ["number", "null"]},
        "longTermLiabilitiesKsek": {"type": ["number", "null"]},
        "tradePayablesKsek": {"type": ["number", "null"]},
        "currentLiabilitiesKsek": {"type": ["number", "null"]},
        "totalEquityAndLiabilitiesKsek": {"type": ["number", "null"]},
        "personnelCostsKsek": {"type": ["number", "null"]},
        "premisesCostsKsek": {"type": ["number", "null"]},
        "marketingCostsKsek": {"type": ["number", "null"]},
        "externalCostsKsek": {"type": ["number", "null"]},
        "employees": {"type": ["number", "null"]},
        "personnelCostPerEmployeeKsek": {"type": ["number", "null"]},
        "margin": {"type": ["number", "null"]},
        "ebitdaMargin": {"type": ["number", "null"]},
        "currentRatioPct": {"type": ["number", "null"]},
        "equityRatioPct": {"type": ["number", "null"]},
        "debtToEquity": {"type": ["number", "null"]},
        "returnOnEquityPct": {"type": ["number", "null"]},
        "returnOnAssetsPct": {"type": ["number", "null"]},
        "revenuePerEmployeeKsek": {"type": ["number", "null"]},
        "profitPerEmployeeKsek": {"type": ["number", "null"]}
      },
      "additionalProperties": false
    }
  }
}
